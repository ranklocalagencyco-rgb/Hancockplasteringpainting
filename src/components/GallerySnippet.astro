---
import { galleryImages } from '../data/gallery';

// First four curated gallery images as a teaser (see src/data/gallery.ts).
const images = galleryImages.slice(0, 4).map((g) => ({
  src: '/gallery/' + encodeURIComponent(g.file),
  alt: g.alt,
  caption: g.caption,
}));
---

{images.length > 0 && (
  <section data-section="gallery_snippet" style="padding:72px 24px;background:#F8FAFC;border-top:1px solid #E2E8F0;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:32px;">
        <div>
          <p style="font-size:12px;font-weight:600;color:#0C7BA8;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 12px;">Our work</p>
          <h2 style="font-family:'Lexend',sans-serif;font-size:clamp(24px,3.5vw,36px);font-weight:600;color:#0F172A;margin:0;letter-spacing:-0.03em;line-height:1.15;">Recent projects</h2>
        </div>
        <a href="/gallery/" style="font-size:14px;font-weight:500;color:#0C7BA8;text-decoration:none;white-space:nowrap;">View full gallery →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;">
        {images.map((item) => (
          <a href="/gallery/" class="snippet-thumb" style="position:relative;display:block;aspect-ratio:4/3;overflow:hidden;border-radius:8px;background:#F1F5F9;">
            <img src={item.src} alt={item.alt} title={item.alt} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.4s ease;" style-hover="transform:scale(1.05);" />
            <span class="snippet-caption">{item.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* Caption slides up on hover; always shown on touch devices (no hover). */
  .snippet-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px 12px 10px;
    font-family: 'Lexend', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.01em;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0) 100%);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  .snippet-thumb:hover .snippet-caption,
  .snippet-thumb:focus-visible .snippet-caption {
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: none) {
    .snippet-caption {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

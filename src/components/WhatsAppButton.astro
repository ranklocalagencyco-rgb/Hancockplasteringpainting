---
// Sticky WhatsApp button, rendered on every page by Layout.
//
// Links to the business mobile via wa.me with a pre-filled opening message
// that names the page the visitor was on (area, service, blog article, or a
// general page), so the enquiry arrives already tagged with its source.
// Pure HTML/CSS: no script, out of flow (no CLS), one small inline SVG.
import { BUSINESS } from '../lib/business';
import { pageContext } from '../lib/page-context';

interface Props {
  /** The page <title> passed to Layout; used to name blog articles. */
  pageTitle?: string;
}
const { pageTitle = '' } = Astro.props;

const page = pageContext(Astro.url.pathname, pageTitle);
const { source } = page;

const GENERAL: Record<string, string> = {
  home: "I'm on your website and I'd like a quote.",
  services_index: "I'm looking at your services page and I'd like a quote.",
  areas_index: "I'm looking at your areas page and I'd like to check you cover my address and get a quote.",
  gallery: "I've been looking at your gallery and I'd like a quote.",
  about: "I'm on your about page and I'd like a quote.",
  contact: "I'm on your contact page and I'd like a quote.",
  blog_index: "I'm on your blog and I'd like some advice on a job.",
  thank_you: "I've just sent an enquiry through your website and wanted to add a message.",
};

let context: string;
if (page.type === 'area') {
  context = `I'm looking at your ${page.name} page and I'd like a quote for a job in ${page.name}.`;
} else if (page.type === 'service') {
  context = `I'm looking at your ${page.name} page and I'd like a quote.`;
} else if (page.type === 'blog') {
  context = `I've just read your article "${page.name}" and I'd like some advice on a job.`;
} else {
  context = GENERAL[page.type] ?? "I'm on your website and I'd like a quote.";
}

const message = `Hi Hancock, ${context}`;
const number = BUSINESS.phone.replace(/\D/g, ''); // wa.me wants digits only, no +
const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---

<a
  class="wa-btn"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={`Chat with Hancock on WhatsApp (${BUSINESS.phoneDisplay})`}
  title="Chat with us on WhatsApp"
  data-source={source}
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16.004 3C8.83 3 3 8.83 3 16.003c0 2.29.6 4.53 1.74 6.5L3 29l6.66-1.74a12.94 12.94 0 0 0 6.34 1.62h.01C23.18 28.88 29 23.06 29 15.9 29 8.83 23.18 3 16.004 3zm0 23.7h-.01a10.75 10.75 0 0 1-5.48-1.5l-.39-.23-3.95 1.03 1.05-3.85-.26-.4A10.7 10.7 0 0 1 5.2 16c0-5.95 4.85-10.8 10.81-10.8 5.95 0 10.8 4.85 10.8 10.8s-4.85 10.7-10.8 10.7zm5.93-8.08c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.73.16-.22.33-.84 1.06-1.03 1.28-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.62-1.62-.97-.86-1.62-1.93-1.81-2.26-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.57.16-.19.22-.33.33-.54.11-.22.05-.41-.03-.57-.08-.16-.73-1.76-1-2.41-.26-.63-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.71s1.17 3.15 1.33 3.37c.16.22 2.3 3.51 5.57 4.92.78.34 1.39.54 1.86.69.78.25 1.5.21 2.06.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.41.19-1.55-.08-.14-.3-.22-.63-.38z"/>
  </svg>
  <span class="wa-label">WhatsApp us</span>
</a>

<style>
  .wa-btn {
    position: fixed;
    right: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 900; /* under the sticky header (1000), over page content */
    display: flex;
    align-items: center;
    gap: 8px;
    height: 56px;
    padding: 0 20px 0 14px;
    background: #25d366;
    color: #ffffff;
    border-radius: 999px;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.28);
    text-decoration: none;
    font-family: 'Lexend', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .wa-btn svg {
    width: 28px;
    height: 28px;
    flex: none;
  }
  .wa-btn:hover {
    background: #1ebe5a;
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.32);
  }
  .wa-btn:focus-visible {
    outline: 3px solid #0c7ba8;
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    .wa-btn {
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      width: 56px;
      padding: 0;
      justify-content: center;
    }
    .wa-btn .wa-label {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-btn {
      transition: none;
    }
    .wa-btn:hover {
      transform: none;
    }
  }
</style>
